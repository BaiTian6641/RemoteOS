-TAILSCALE_VERSION = 1.78.1
+TAILSCALE_VERSION = 1.104.1
 TAILSCALE_SITE = $(call github,tailscale,tailscale,v$(TAILSCALE_VERSION))
 TAILSCALE_LICENSE = BSD-3-Clause
 TAILSCALE_LICENSE_FILES = LICENSE
@@ -12,6 +12,11 @@
 TAILSCALE_CPE_ID_VENDOR = tailscale
 TAILSCALE_BUILD_TARGETS = cmd/tailscale cmd/tailscaled
 TAILSCALE_INSTALL_BINS = tailscale tailscaled
+# This appliance is a VPN client. Omit unrelated servers and routing roles;
+# verified with upstream cmd/featuretags and its feature dependency graph.
+TAILSCALE_TAGS = ts_omit_acme ts_omit_advertiseexitnode ts_omit_advertiseroutes \
+	ts_omit_appconnectors ts_omit_bird ts_omit_drive ts_omit_serve \
+	ts_omit_ssh ts_omit_taildrop ts_omit_tap ts_omit_webclient
 TAILSCALE_LDFLAGS = \
 	-X tailscale.com/version.longStamp=$(TAILSCALE_VERSION) \
 	-X tailscale.com/version.shortStamp=$(TAILSCALE_VERSION)
