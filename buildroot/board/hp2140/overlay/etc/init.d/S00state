#!/bin/sh
set -eu
[ "${1:-}" = start ] || exit 0
mkdir -p /state /run/remoteos /run/lock /run/dbus
# Never format a disk during startup. An absent/corrupt state partition is a
# recoverable diagnostic session; credentials in that session are not persisted.
state_device=$(/usr/sbin/remoteos-state-device) || state_device=
if [ -z "$state_device" ] || [ ! -b "$state_device" ] || \
   [ "$(blkid -p -s LABEL -o value "$state_device" 2>/dev/null)" != REMOTEOS_STATE ] || \
   ! mount -t ext4 -o nosuid,nodev "$state_device" /state; then
    echo 'Persistent state unavailable; using temporary state' >&2
    mount -t tmpfs -o mode=0755,size=128m tmpfs /state
    : > /run/remoteos/ephemeral-state
fi
mkdir -p /state/seedrng /state/home /state/alsa /state/tailscale /state/network /state/pairing /state/reports /state/remoteos/client
chmod 700 /state/seedrng /state/tailscale /state/network /state/pairing
chown 600:600 /state/home /state/remoteos/client
chmod 700 /state/home /state/remoteos/client
if [ ! -s /state/machine-id ]; then
    tr -d '-' < /proc/sys/kernel/random/uuid > /state/machine-id
fi
mkdir -p /tmp/dbus
ln -sfn /state/machine-id /tmp/dbus/machine-id
# This ownership header lets Tailscale choose openresolv rather than attempting
# an atomic write/rename under the read-only /etc directory.
printf '# Generated by resolvconf\n' > /run/resolv.conf
resolvconf -u
